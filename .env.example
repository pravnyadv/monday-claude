# The simplest persistent option is `mon.js login` (saves the token to ~/.config/monday-claude,
# chmod 600). This .env is an alternative: copy it to .env and run  node --env-file=.env mon.js ...
# (A bare `export monday_api_key=<token>` only lasts the current terminal session; for persistence
# add it to ~/.zshrc, or for Claude Code put it in ~/.claude/settings.json under "env".)
#
# Get a token in monday.com: avatar -> Developers -> My Access Tokens.
# The token acts AS the user it belongs to: every write is posted by that user.
monday_api_key=your_monday_api_token_here
